#!/usr/bin/env python3
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "fmv-core-python"))

from fmvcore.hook import Check, Gates, run  # noqa: E402

UV = ("uv", "--project", "tools", "run")
GATES = Gates(
    always=(
        Check("format", (*UV, "ruff", "format", "--check", "tools/")),
        Check("lint", (*UV, "ruff", "check", "tools/")),
        Check("types", (*UV, "mypy", "tools/smsggmedia", "tools/scripts")),
        Check(
            "tests",
            (
                *UV,
                "python",
                "-m",
                "pytest",
                "tools/tests",
                "--cov=smsggmedia",
                "--cov=tools/scripts",
                "--cov-config=tools/pyproject.toml",
                "--cov-fail-under=95",
            ),
        ),
    ),
    player=(
        Check("rom", ("make", "rom")),
        Check("rom-gg", ("make", "rom", "TARGET=gg")),
        Check("analyse", ("make", "analyse")),
        Check("timing", ("make", "timing")),
        Check("timing-gg", ("make", "timing", "TARGET=gg")),
        Check(
            "replay",
            (
                *UV,
                "python",
                "-m",
                "pytest",
                "tools/tests/test_replay_on_z80.py",
                "tools/tests/test_player_on_z80.py",
                "tools/tests/test_osd_on_z80.py",
                "tools/tests/test_diag_on_z80.py",
                "tools/tests/test_seek_on_z80.py",
                "tools/tests/test_transport_on_z80.py",
                "tools/tests/test_screen_on_z80.py",
                "tools/tests/test_gg_build.py",
            ),
        ),
    ),
    player_paths=(
        "src/",
        "include/",
        "Makefile",
        "Dockerfile",
        "tools/smsggmedia/vdptiming.py",
        "tools/scripts/check_vdp_timing.py",
    ),
    always_required={"SMSGGMEDIA_FFMPEG_REQUIRED": "1"},
    player_required={"SMSGGMEDIA_FFMPEG_REQUIRED": "1", "SMSGGMEDIA_ROM_REQUIRED": "1"},
)

if __name__ == "__main__":
    sys.exit(run(ROOT, GATES))
